# Core runtime
NODE_ENV=development
PORT=5000
APP_URL=http://localhost:5000
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
SESSION_SECRET=replace-with-at-least-32-random-characters
CRON_SECRET=replace-with-at-least-16-random-characters

# Clerk authentication
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# Google Cloud Storage
GCS_PROJECT_ID=
GCS_CLIENT_EMAIL=
GCS_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
PUBLIC_OBJECT_SEARCH_PATHS=/your-bucket/public
PRIVATE_OBJECT_DIR=/your-bucket/private

# AI and OCR parsing
OPENAI_API_KEY=

# Payments
STRIPE_SECRET_KEY=
BILLCOM_USERNAME=
BILLCOM_PASSWORD=
BILLCOM_ORG_ID=
BILLCOM_DEV_KEY=

# Email: use SMTP, or SendGrid in production
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SENDGRID_API_KEY=
EMAIL_FROM=no-reply@billwatch.pro
EMAIL_REPLY_TO=support@billwatch.pro
COMPANY_NAME=BillWatch

# Existing BillWatch integrations
FINANCE_WATCH_API_URL=
FINANCE_WATCH_API_KEY=
MEMBERSHIP_VERIFY_API_KEY=
BILLWATCH_EXPORT_TOKEN=
BILLWATCH_IMPORT_API_URL=
